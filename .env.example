# Copy to .env (npm install does this automatically with a random EDIT_CODE).

# Secret that unlocks editing in the UI. Anyone with this can change scores.
# Keep it private; share only with co-organisers.
EDIT_CODE=change-me

# Port the single Express server listens on (serves both the API and the UI).
PORT=8787

# How often (ms) the server polls worldcup26.ir for finished group results.
POLL_INTERVAL_MS=180000

# Set to "0" to disable the background poller entirely (paste/manual only).
POLL_ENABLED=1

# Base URL of the upstream results API. Rarely needs changing.
WC_API_BASE=https://worldcup26.ir
